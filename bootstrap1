# One-time fix when main only contains an uploaded zip (not extracted tree).
# Add this file via GitHub web UI, commit — workflow extracts and pushes real project files.
name: Bootstrap from zip

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - '*.zip'
      - '.github/workflows/bootstrap-from-zip.yml'

permissions:
  contents: write

jobs:
  extract:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Extract uploaded zip to repo root
        id: extract
        run: |
          set -euo pipefail
          if [[ -f coach.html ]]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "coach.html already present — nothing to extract."
            exit 0
          fi
          ZIP=""
          for candidate in thehybriddashboard.zip Thehybriddashboard.zip hybrid-dashboard.zip; do
            if [[ -f "$candidate" ]]; then ZIP="$candidate"; break; fi
          done
          if [[ -z "$ZIP" ]]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "No bootstrap zip found at repo root."
            exit 0
          fi
          echo "Extracting $ZIP …"
          unzip -o "$ZIP"
          rm -f "$ZIP" thehybriddashboard.zip Thehybriddashboard.zip hybrid-dashboard.zip
          if [[ ! -f coach.html ]]; then
            echo "coach.html missing after extract — zip layout may be wrong." >&2
            exit 1
          fi
          echo "skip=false" >> "$GITHUB_OUTPUT"

      - name: Commit extracted tree
        if: steps.extract.outputs.skip != 'true'
        run: |
          set -euo pipefail
          git add -A
          if git diff --cached --quiet; then
            echo "No changes after extract."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git commit -m "chore: extract Hybrid Dashboard project from upload zip"
          git push
